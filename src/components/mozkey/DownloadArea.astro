---
import { mozkey } from "../../data/mozkey";

const { distribution, links } = mozkey;
const fallbackPublishedText = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo", year: "numeric", month: "numeric", day: "numeric",
}).format(new Date(distribution.publishedAt));
const files = [
  { key: "windows-x64", os: "Windows", title: "Windows x64", subtitle: "Intel / AMD（64-bit）", asset: distribution.assets.windowsX64 },
  { key: "windows-arm64", os: "Windows", title: "Windows ARM64", subtitle: "Windows on Arm", asset: distribution.assets.windowsArm64 },
  { key: "macos", os: "macOS", title: "macOS Universal", subtitle: "Apple Silicon / Intel", asset: distribution.assets.macosUniversal },
] as const;
---

<section class="mz-section mz-download" id="download" aria-labelledby="download-title" data-mz-fallback-published={distribution.publishedAt}>
  <div class="mz-shell">
    <div class="mz-download__heading">
      <span class="mz-kicker">GET MOZKEY<img class="mz-download__kicker-icon" src="/mozkey/icon.svg" width="20" height="20" alt="" loading="lazy" decoding="async" /></span>
      <h2 id="download-title">Mozkeyを使ってみる。</h2>
      <p>お使いの環境に合うインストーラーを、ここから直接ダウンロードできます。</p>
    </div>

    <div class="mz-dl__selection" id="mz-download-selection" aria-live="polite">
      <span class="mz-dl__selection-label" data-mz-recommend-label>配布バージョン</span>
      <div class="mz-dl__selection-text">
        <strong data-mz-recommend-title>Mozkey {distribution.version}</strong>
        <p data-mz-recommend-desc>OS・CPUに対応するインストーラーを選んでください。</p>
      </div>
      <a class="mz-button mz-button--primary mz-dl__suggested-button" data-mz-recommended-download href="#download" hidden>
        推奨版をダウンロード <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div class="mz-dl__cards" aria-label="OS別のダウンロード">
      {files.map((item) => (
        <article class="mz-dl__card" data-mz-platform={item.key}>
          <div class="mz-dl__card-heading">
            <span class="mz-dl__platform">{item.os}</span>
            <span class="mz-dl__rec-tag" hidden>お使いの環境向け</span>
          </div>
          <h3>{item.title}</h3>
          <p class="mz-dl__subtitle">{item.subtitle}</p>
          <p class="mz-dl__version"><span class="mz-dl__new-tag" data-mz-card-new hidden aria-label="公開から3か月以内の新しいリリース">New!!</span> <span data-mz-file-version>{distribution.version}</span><span class="mz-dl__published" data-mz-card-published>（<time data-mz-card-release-date datetime={distribution.publishedAt}>{fallbackPublishedText}</time>）</span> <span aria-hidden="true">·</span> <span data-mz-file-size>{item.asset.sizeLabel}</span></p>
          <a
            class="mz-dl__file-link"
            href={item.asset.url}
            data-mz-file={item.key}
            aria-label={`${item.title}版 Mozkey ${distribution.version} をダウンロード`}
          >
            インストーラーをダウンロード <span aria-hidden="true">↓</span>
          </a>
          <p class="mz-dl__filename" data-mz-file-name>{item.asset.name}</p>
          <details class="mz-dl__checksum">
            <summary>SHA-256を表示</summary>
            <code data-mz-file-sha256>{item.asset.sha256}</code>
          </details>
        </article>
      ))}
    </div>


    <!-- MOZKEY PLAYBACK AND INSTALL GUIDE V2: concise, OS-specific help. -->
    <section class="mz-install" aria-labelledby="mz-install-title">
      <div class="mz-install__intro">
        <span class="mz-kicker">INSTALLATION</span>
        <div class="mz-install__title-row">
          <span class="mz-install__alert-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
            </svg>
          </span>
          <div class="mz-install__title-copy">
            <h3 id="mz-install-title">インストールのご案内</h3>
            <p>はじめてインストールする方へ。OS別の手順と確認事項をご案内します。</p>
          </div>
        </div>
      </div>
      <div class="mz-install__notice" role="note" aria-label="インストール前の確認事項">
        <p class="mz-install__notice-heading">インストール時に警告が表示される場合があります</p>
        <p>現在公開しているMozkey v1.0.0のインストーラーは、Windows版がコード署名されておらず、macOS版もApple Developer IDによる署名・公証が行われていません。</p>
        <p>そのため、インストール時にOSのセキュリティ警告が表示される場合があります。</p>
        <p>このページのダウンロードボタンからインストーラーを入手できます。警告が表示された場合は、以下のOS別の手順をご確認ください。</p>
        <p class="mz-install__notice-critical"><strong>重要：</strong>マルウェア検出やファイル破損の警告が表示された場合は、実行しないでください。OSの保護機能全体を無効化する必要はありません。</p>
        <p class="mz-install__notice-signing"><a href={links.signing} target="_blank" rel="noopener noreferrer">コード署名の方針 ↗</a></p>
      </div>
      <div class="mz-install__grid">
        <details class="mz-install__card">
          <summary><span><strong>Windows</strong><small>MSI・SmartScreenの確認</small></span><span class="mz-install__chevron" aria-hidden="true">＋</span></summary>
          <ol>
            <li>お使いのCPUに合ったMSIをダウンロードし、ダブルクリックしてインストールします。</li>
            <li>SmartScreenで警告が出た場合は、このページから入手したファイルであることを確かめ、「詳細情報」で内容を確認してください。信頼できると判断できる場合に限り「実行」を選択できます。</li>
            <li>インストール後は <strong>Win + Space</strong> でMozkeyを選択します。表示されなければ再サインインまたは再起動してください。</li>
          </ol>
          <p>既存版から更新する前に、設定やユーザー辞書をバックアップしてください。</p>
        </details>
        <details class="mz-install__card">
          <summary><span><strong>macOS</strong><small>Gatekeeperの確認・再ログイン</small></span><span class="mz-install__chevron" aria-hidden="true">＋</span></summary>
          <ol>
            <li>Universal PKGをダウンロードし、Finderから開いてインストールします。</li>
            <li>開発元を確認できない警告が出た場合は、このページから入手したファイルであることを確かめてから、<strong>システム設定 → プライバシーとセキュリティ → このまま開く</strong>で対象PKGのみ許可できます。</li>
            <li>インストール後は<strong>ログアウト・再ログイン</strong>し、<strong>システム設定 → キーボード → テキスト入力 → 編集</strong>から「ひらがな（Mozkey）」を選択または追加します。</li>
          </ol>
          <p><a href="https://support.apple.com/ja-jp/102445" target="_blank" rel="noopener noreferrer">Appleのセキュリティ案内 ↗</a></p>
        </details>
      </div>
      <details class="mz-install__file-check">
        <summary>ダウンロードしたファイルの確認方法（詳しい方向け）</summary>
        <p>各カードの「SHA-256を表示」にある英数字は、ファイルが配布時のものと一致するか調べるための値です。</p>
        <ul>
          <li>Windows：PowerShellで <code>Get-FileHash "ファイルのパス" -Algorithm SHA256</code> を実行。</li>
          <li>macOS：ターミナルで <code>shasum -a 256 "ファイルのパス"</code> を実行。</li>
        </ul>
        <p>「ファイルのパス」はダウンロードしたMSIまたはPKGの保存先に置き換えてください。計算された値がカードの表示と一致しなければ実行しないでください。一致しても安全性を保証するものではありません。</p>
      </details>
      <a class="mz-install__more" href={links.readme} target="_blank" rel="noopener noreferrer">詳しい手順はREADMEへ <span aria-hidden="true">↗</span></a>
    </section>
    <p class="mz-dl__os-note">Linux向けインストーラーは現在公開していません。スマートフォン・タブレットにも対応していません。</p>
    <div class="mz-dl__footnotes">
      <p>Windows向けMSIは現在未署名です。macOSでもセキュリティ確認が必要な場合があります。OSの保護機能全体を無効化しないでください。 <a href={links.signing} target="_blank" rel="noopener noreferrer">署名ポリシー ↗</a></p>
      <p>配布元はMozkey公式GitHub Releasesです。<a href={distribution.checksumsUrl} data-mz-checksums>SHA-256チェックサムを確認 ↗</a> <span aria-hidden="true">·</span> <a href={links.releases} data-mz-release-notes target="_blank" rel="noopener noreferrer">リリースノート ↗</a></p>
      <p data-mz-release-status role="status" aria-live="polite">最新リリースを確認しています。JavaScriptが無効な場合は、サイトに保存された{distribution.version}の配布情報を表示します。</p>
    </div>
  </div>
</section>

<script>
  // The site uses its own Cloudflare API endpoint; no user IP / UA is sent to GitHub.
  // SSR contains a verified v1.0.0 fallback, so downloads remain available without JS.
  type DownloadKey = "windows-x64" | "windows-arm64" | "macos";
  type AssetKey = "windowsX64" | "windowsArm64" | "macosUniversal";
  type ReleaseAsset = { name: string; url: string; size: number; sha256: string };
  type LatestRelease = {
    version: string;
    publishedAt: string;
    checkedAt: string;
    stale?: boolean;
    releaseUrl: string;
    checksumsUrl: string;
    assets: Record<AssetKey, ReleaseAsset>;
  };
  type UAData = {
    platform?: string;
    getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string; bitness?: string }>;
  };

  const directCtas = document.querySelectorAll<HTMLAnchorElement>("[data-mz-direct-cta]");
  const otherOsButton = document.querySelector<HTMLAnchorElement>(".mz-hero__other-os");
  const recommendButton = document.querySelector<HTMLAnchorElement>("[data-mz-recommended-download]");
  const recommendTitle = document.querySelector<HTMLElement>("[data-mz-recommend-title]");
  const recommendDesc = document.querySelector<HTMLElement>("[data-mz-recommend-desc]");
  const recommendLabel = document.querySelector<HTMLElement>("[data-mz-recommend-label]");
  const releaseStatus = document.querySelector<HTMLElement>("[data-mz-release-status]");
  let activeVersion = document.querySelector<HTMLElement>("[data-mz-file-version]")?.textContent?.trim() || "v1.0.0";
  const cards: { key: DownloadKey; assetKey: AssetKey; label: string }[] = [
    { key: "windows-x64", assetKey: "windowsX64", label: "Windows x64" },
    { key: "windows-arm64", assetKey: "windowsArm64", label: "Windows ARM64" },
    { key: "macos", assetKey: "macosUniversal", label: "macOS Universal" },
  ];

  function isRelease(value: unknown): value is LatestRelease {
    if (!value || typeof value !== "object") return false;
    const release = value as Record<string, unknown>;
    if (typeof release.version !== "string" || !/^v\d+\.\d+\.\d+$/.test(release.version)) return false;
    if (typeof release.publishedAt !== "string" || !Number.isFinite(Date.parse(release.publishedAt)) ||
        typeof release.checkedAt !== "string") return false;
    if (!release.assets || typeof release.assets !== "object") return false;
    const base = `https://github.com/koyasi777/mozkey/releases/download/${release.version}/`;
    const assets = release.assets as Record<string, unknown>;
    for (const item of cards) {
      const asset = assets[item.assetKey] as Record<string, unknown> | undefined;
      const suffixes = item.assetKey === "windowsX64" ? ["windows_x64.msi", "x64.msi"] :
        item.assetKey === "windowsArm64" ? ["windows_arm64.msi", "arm64.msi"] : ["macos_universal.pkg"];
      const allowedNames = suffixes.map((suffix) => `Mozkey_${release.version}_${suffix}`);
      if (!asset || typeof asset.name !== "string" || !allowedNames.includes(asset.name) ||
          asset.url !== base + asset.name ||
          typeof asset.size !== "number" || asset.size <= 0 || !Number.isFinite(asset.size) ||
          typeof asset.sha256 !== "string" || !/^[a-f0-9]{64}$/i.test(asset.sha256)) return false;
    }
    return release.checksumsUrl === base + "SHA256SUMS.txt" &&
      release.releaseUrl === `https://github.com/koyasi777/mozkey/releases/tag/${release.version}`;
  }

  function isWithinThreeMonthsOfReleaseJST(publishedAt: string): boolean {
    const formatter = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Tokyo", year: "numeric", month: "numeric", day: "numeric",
    });
    const calendarDay = (value: Date) => {
      const parts = formatter.formatToParts(value);
      const number = (type: string): number => Number(parts.find((part) => part.type === type)?.value);
      return { year: number("year"), month: number("month"), day: number("day") };
    };
    const published = calendarDay(new Date(publishedAt));
    const today = calendarDay(new Date());
    const start = Date.UTC(published.year, published.month - 1, published.day);
    const current = Date.UTC(today.year, today.month - 1, today.day);
    const expiryMonth = new Date(Date.UTC(published.year, published.month - 1 + 3, 1));
    const expiryYear = expiryMonth.getUTCFullYear();
    const expiryMonthIndex = expiryMonth.getUTCMonth();
    const lastDay = new Date(Date.UTC(expiryYear, expiryMonthIndex + 1, 0)).getUTCDate();
    const expiry = Date.UTC(expiryYear, expiryMonthIndex, Math.min(published.day, lastDay));
    return current >= start && current < expiry;
  }

  function setStatus(text: string): void {
    if (releaseStatus) releaseStatus.textContent = text;
  }

  function showFallbackReleaseBadges(): void {
    // The build-time release date is verified independently of the live API.
    // Never infer that this fallback is the latest published release.
    const publishedAt = document.querySelector<HTMLElement>(".mz-download")?.dataset.mzFallbackPublished;
    if (!publishedAt || !Number.isFinite(Date.parse(publishedAt))) return;
    const isNew = isWithinThreeMonthsOfReleaseJST(publishedAt);
    document.querySelectorAll<HTMLElement>("[data-mz-card-new]").forEach((badge) => {
      badge.hidden = !isNew;
    });
  }

  async function updateRelease(): Promise<void> {
    try {
      const response = await fetch("/api/mozkey/release", { cache: "no-store", headers: { Accept: "application/json" } });
      if (!response.ok) throw new Error("Latest release unavailable");
      const remote: unknown = await response.json();
      if (!isRelease(remote)) throw new Error("Unexpected release response");
      const release = remote;
      const publishedText = new Intl.DateTimeFormat("ja-JP", {
        timeZone: "Asia/Tokyo", year: "numeric", month: "numeric", day: "numeric",
      }).format(new Date(release.publishedAt));
      const isNew = isWithinThreeMonthsOfReleaseJST(release.publishedAt);

      // Validate all assets BEFORE mutating links to avoid mixed versions.
      for (const item of cards) {
        const card = document.querySelector<HTMLElement>(`[data-mz-platform="${item.key}"]`);
        const link = card?.querySelector<HTMLAnchorElement>("[data-mz-file]");
        if (!card || !link || !card.querySelector("[data-mz-card-published]") ||
            !card.querySelector("[data-mz-card-release-date]") ||
            !card.querySelector("[data-mz-card-new]")) throw new Error("Missing download card metadata");
      }
      for (const item of cards) {
        const card = document.querySelector<HTMLElement>(`[data-mz-platform="${item.key}"]`)!;
        const asset = release.assets[item.assetKey];
        const link = card.querySelector<HTMLAnchorElement>("[data-mz-file]")!;
        link.href = asset.url;
        link.setAttribute("aria-label", `${item.label}版 Mozkey ${release.version} をダウンロード`);
        const version = card.querySelector<HTMLElement>("[data-mz-file-version]");
        const size = card.querySelector<HTMLElement>("[data-mz-file-size]");
        const name = card.querySelector<HTMLElement>("[data-mz-file-name]");
        const sha256 = card.querySelector<HTMLElement>("[data-mz-file-sha256]");
        if (version) version.textContent = release.version;
        if (size) size.textContent = `${Math.round(asset.size / (1024 * 1024))} MB`;
        if (name) name.textContent = asset.name;
        if (sha256) sha256.textContent = asset.sha256;
        const published = card.querySelector<HTMLElement>("[data-mz-card-published]")!;
        const publishedDate = card.querySelector<HTMLTimeElement>("[data-mz-card-release-date]")!;
        const newBadge = card.querySelector<HTMLElement>("[data-mz-card-new]")!;
        publishedDate.dateTime = release.publishedAt;
        publishedDate.textContent = publishedText;
        published.hidden = false;
        newBadge.hidden = !isNew;
      }
      const checksums = document.querySelector<HTMLAnchorElement>("[data-mz-checksums]");
      const notes = document.querySelector<HTMLAnchorElement>("[data-mz-release-notes]");
      if (checksums) checksums.href = release.checksumsUrl;
      if (notes) notes.href = release.releaseUrl;
      activeVersion = release.version;
      if (recommendTitle) recommendTitle.textContent = `Mozkey ${release.version}`;
      setStatus(release.stale === true ? `最後に確認できた正式版 ${release.version} を表示しています（GitHub公開日：${publishedText}・日本時間）。最新情報は一時的に確認できていません。` : `最新の正式版 ${release.version} を確認しました（GitHub公開日：${publishedText}・日本時間）。新しい正式リリースは反映までしばらくかかる場合があります。`);
    } catch {
      // Keep the dated, verified fallback; never claim it is the latest published release.
      setStatus("最新の配布情報を確認できませんでした。現在はサイトに保存されたv1.0.0の情報を表示しています。最新情報はGitHub Releasesをご確認ください。");
    }
  }

  async function detectPlatform(): Promise<{ key: DownloadKey | null; message: string }> {
    const ua = navigator.userAgent || "";
    const agent = (navigator as Navigator & { userAgentData?: UAData }).userAgentData;
    const platform = agent?.platform || navigator.platform || "";
    if (/android|iphone|ipad|ipod/i.test(ua) || (/mac/i.test(platform) && navigator.maxTouchPoints > 1)) {
      return { key: null, message: "スマートフォン・タブレットには対応していません。WindowsまたはMacからご利用ください。" };
    }
    if (/mac/i.test(platform) || /macintosh/i.test(ua)) {
      return { key: "macos", message: "macOSを検出しました。Universal版をご利用いただけます。" };
    }
    if (/win/i.test(platform) || /windows/i.test(ua)) {
      if (typeof agent?.getHighEntropyValues === "function") {
        try {
          const info = await agent.getHighEntropyValues(["architecture", "bitness"]);
          const arch = (info.architecture || "").toLowerCase();
          if (info.bitness === "64" && /^(arm|aarch64)/.test(arch)) {
            return { key: "windows-arm64", message: "Windows ARM64環境向けのインストーラーをおすすめします。" };
          }
          if (info.bitness === "64" && /^(x86|x86_64|amd64)$/.test(arch)) {
            return { key: "windows-x64", message: "Windows x64向けのインストーラーをおすすめします。" };
          }
        } catch { /* Never guess architecture from a potentially emulated browser */ }
      }
      return { key: null, message: "Windowsを検出しました。CPUがIntel/AMDならx64版、Windows on ArmならARM64版を選んでください。" };
    }
    if (/linux/i.test(platform) || /linux/i.test(ua)) {
      return { key: null, message: "Linux版インストーラーは現在公開していません。" };
    }
    return { key: null, message: "OSを自動判定できませんでした。対応するインストーラーを選んでください。" };
  }

  async function initDownloads(): Promise<void> {
    // Show the known release badge even when the live API is unavailable.
    showFallbackReleaseBadges();
    // Release metadata first: the direct CTA must never point to the old version after a successful refresh.
    await updateRelease();
    const result = await detectPlatform();
    if (recommendDesc) recommendDesc.textContent = result.message;
    if (!result.key) return;
    const candidate = document.querySelector<HTMLAnchorElement>(`[data-mz-file="${result.key}"]`);
    const card = document.querySelector<HTMLElement>(`[data-mz-platform="${result.key}"]`);
    if (!candidate || !card) return;
    // Only reveal the alternate-OS link when the primary CTA is a verified direct download.
    if (otherOsButton) otherOsButton.hidden = false;
    const label = cards.find((item) => item.key === result.key)?.label ?? "Mozkey";
    const architecture = result.key === "windows-arm64" ? "ARM64" :
      result.key === "windows-x64" ? "x64" : null;
    const heroLabel = document.querySelector<HTMLElement>("[data-mz-hero-download-label]");
    const heroMeta = document.querySelector<HTMLElement>("[data-mz-hero-download-meta]");
    if (heroLabel) {
      if (architecture) {
        const arch = document.createElement("span");
        arch.className = "mz-hero__download-architecture";
        arch.textContent = `(${architecture})`;
        heroLabel.replaceChildren("Windows版", arch, " をダウンロード");
      } else {
        heroLabel.textContent = "macOS版 をダウンロード";
      }
    }
    if (heroMeta) {
      const fileSize = card.querySelector<HTMLElement>("[data-mz-file-size]")?.textContent?.trim();
      const format = result.key === "macos" ? "PKG" : "MSI";
      heroMeta.textContent = [activeVersion, format, fileSize].filter(Boolean).join(" · ");
    }
    const directAriaLabel = architecture
      ? `Windows版（${architecture}）Mozkeyを直接ダウンロード`
      : "macOS版 Mozkeyを直接ダウンロード";
    directCtas.forEach((anchor) => {
      anchor.href = candidate.href;
      anchor.setAttribute("aria-label", directAriaLabel);
    });
    if (recommendLabel) recommendLabel.textContent = "推奨ダウンロード";
    if (recommendTitle) recommendTitle.textContent = `${label} · Mozkey ${activeVersion}`;
    if (recommendButton) {
      recommendButton.href = candidate.href;
      recommendButton.hidden = false;
      recommendButton.setAttribute("aria-label", `${label}版 Mozkeyを直接ダウンロード`);
    }
    card.classList.add("mz-dl__card--recommended");
    const mark = card.querySelector<HTMLElement>(".mz-dl__rec-tag");
    if (mark) mark.hidden = false;
  }

  void initDownloads();
</script>

<style>
  /* Small brand accent beside GET MOZKEY, not inside the Japanese heading */
  .mz-download__kicker-icon { display: block; flex: none; width: 20px; height: 20px; }
  .mz-dl__selection { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; max-width: 1010px; margin: 0 auto 22px; border: 1px solid #c8ded2; border-radius: 14px; background: #eaf4ef; padding: 19px 24px; }
