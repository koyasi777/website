---
import "../../styles/mozkey.css";
import ProductDemo from "../../components/mozkey/ProductDemo.astro";
import DownloadArea from "../../components/mozkey/DownloadArea.astro";
import { mozkey } from "../../data/mozkey";

const { links, media } = mozkey;
const values = [
  { href: "#features", number: "01", title: "自然に変換", detail: "ライブ変換とAI文脈補正" },
  { href: "#personal", number: "02", title: "使うほど馴染む", detail: "あなたの選択を学ぶ" },
  { href: "#customization", number: "03", title: "自分好みに", detail: "見た目も操作も自由に" },
];
const softwareApplicationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: mozkey.name,
  alternateName: "もずきー",
  description: mozkey.description,
  url: mozkey.canonical,
  image: "https://koyasi777.com/mozkey/icon.svg",
  inLanguage: "ja",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows, macOS",
  isAccessibleForFree: true,
  downloadUrl: mozkey.links.releases,
  sameAs: mozkey.links.repository,
  author: { "@type": "Person", name: "koyasi777", url: mozkey.links.creator },
  offers: {
    "@type": "Offer",
    price: 0,
    priceCurrency: "JPY",
    url: mozkey.links.releases,
  },
}).replace(/</g, "\\u003c");

---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7faf8" />
    <title>{mozkey.pageTitle}</title>
    <meta name="description" content={mozkey.description} />
    <link rel="canonical" href={mozkey.canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mozkey" />
    <meta property="og:title" content={mozkey.pageTitle} />
    <meta property="og:description" content={mozkey.description} />
    <meta property="og:url" content={mozkey.canonical} />
    <meta property="og:image" content="https://koyasi777.com/og/mozkey.png?v=20261101" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mozkey — 書くことに集中できる、日本語入力。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={mozkey.pageTitle} />
    <meta name="twitter:description" content={mozkey.description} />
    <meta name="twitter:image" content="https://koyasi777.com/og/mozkey.png?v=20261101" />
    <meta name="twitter:image:alt" content="Mozkey — 書くことに集中できる、日本語入力。" />
    <link rel="icon" href="/mozkey/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline type="application/ld+json" set:html={softwareApplicationJsonLd} />
  </head>
  <body>
    <a class="mz-skip" href="#main-content">本文へスキップ</a>
    <header class="mz-header">
      <div class="mz-shell mz-header__inner">
        <a class="mz-brand" href="/" aria-label="koyasi777 ホーム">
          <img src="/koyasi777-icon.jpg" width="36" height="36" alt="" decoding="async" />
          <span>koyasi777</span>
        </a>
        <nav class="mz-nav" aria-label="Mozkey ナビゲーション">
          <a class="mz-nav__features" href="#features">特徴</a>
          <a class="mz-nav__github" href={links.repository} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a class="mz-button mz-button--small" data-mz-direct-cta href="#download">ダウンロード <span aria-hidden="true">↓</span></a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="mz-hero" aria-labelledby="mozkey-title">
        <div class="mz-shell mz-hero__topline">
          <div class="mz-hero__identity">
            <img class="mz-hero__logo" src="/mozkey/icon.svg" width="80" height="80" alt="" decoding="async" fetchpriority="high" />
            <div class="mz-hero__identity-copy">
              <p class="mz-hero__name">Mozkey</p>
              <p class="mz-eyebrow"><span class="mz-eyebrow__line" aria-hidden="true"></span> OPEN SOURCE JAPANESE IME</p>
            </div>
          </div>
        </div>
        <div class="mz-shell mz-hero__grid">
          <div class="mz-hero__copy">
            <h1 id="mozkey-title">書くことに集中できる、<br class="mz-heading-break" /><span class="mz-hero__final-phrase">日本語入力。</span></h1>
            <p class="mz-hero__lead">自然に変換し、使うほど馴染む。<br class="mz-desktop-break" />あなたの入力スタイルに合わせられる、日本語IME。</p>
            <div class="mz-hero__actions">
              <a class="mz-button mz-button--primary mz-hero__download" data-mz-direct-cta href="#download">
                <svg class="mz-hero__download-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 18v3h16v-3" /></svg>
                <span class="mz-hero__download-copy">
                  <strong data-mz-hero-download-label>対応版を選ぶ</strong>
                  <small data-mz-hero-download-meta>Windows / macOS · インストーラー一覧へ</small>
                </span>
              </a>
              <a class="mz-text-link mz-hero__other-os" href="#download" hidden>他のOSを見る <span aria-hidden="true">↓</span></a>
            </div>
            <div class="mz-hero__stats" data-mz-stats hidden aria-label="GitHubの公開統計とリポジトリへのリンク">
              <span class="mz-hero__stats-github-row" data-mz-stats-fallback hidden>
                <a class="mz-hero__stats-github" href={links.repository} target="_blank" rel="noopener noreferrer">GitHubを見る <span aria-hidden="true">↗</span></a>
              </span>
              <a href={links.repository} target="_blank" rel="noopener noreferrer" data-mz-stars-stat hidden title="GitHubでスターを付けたユーザー数"><span aria-hidden="true">☆</span> <strong data-mz-stars-count></strong> GitHub Stars</a>
              <a href={links.releases} target="_blank" rel="noopener noreferrer" data-mz-downloads-stat hidden title="GitHub Releasesに公開された全リリース（開発版・旧myproduct版を含む）のMSI・PKGダウンロード回数合計。人数やインストール数ではありません。"><span aria-hidden="true">↓</span> <strong data-mz-downloads-count></strong> ダウンロード</a>
            </div>
            <div class="mz-values mz-values--mobile" aria-label="Mozkeyの3つの強み">
              {values.map((item) => (
                <a class="mz-value" href={item.href}>
                  <span class="mz-value__number" aria-hidden="true">{item.number}</span>
                  <span class="mz-value__text"><strong>{item.title}</strong><span>{item.detail}</span></span>
                  <span class="mz-value__arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
          <div class="mz-hero__media">
            <ProductDemo id="hero-demo" prominent={true} {...media.hero} />
          </div>
        </div>
        <div class="mz-shell mz-values mz-values--desktop" aria-label="Mozkeyの3つの強み">
          {values.map((item) => (
            <a class="mz-value" href={item.href}>
              <span class="mz-value__number" aria-hidden="true">{item.number}</span>
              <span class="mz-value__text"><strong>{item.title}</strong><span>{item.detail}</span></span>
              <span class="mz-value__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="mz-section mz-section--border" id="features" aria-labelledby="natural-title">
        <div class="mz-shell mz-feature">
          <div class="mz-feature__copy">
            <span class="mz-kicker">01 / NATURAL</span>
            <h2 id="natural-title">変換を意識せず、<br />思いのままに。</h2>
            <p>スペースを押す前から文章を変換。Mozcの通常変換とローカルAIのZenzによる文脈補正が、自然な入力を支えます。</p>
            <a class="mz-inline-link" href={links.readme} target="_blank" rel="noopener noreferrer">変換機能の詳細を読む <span aria-hidden="true">↗</span></a>
          </div>
          <div class="mz-feature__visual">
            <ProductDemo id="natural-demo" {...media.natural} />
          </div>
        </div>
      </section>

      <section class="mz-section mz-section--tint" id="personal" aria-labelledby="personal-title">
        <div class="mz-shell mz-feature mz-feature--reverse">
          <div class="mz-feature__copy">
            <span class="mz-kicker">02 / PERSONAL</span>
            <h2 id="personal-title">使うほど、<br />自分の言葉に。</h2>
            <p>選んだ表記を学び、好まない補正は控える。使い続けるほど、あなたの書き方に馴染んでいきます。</p>
            <p class="mz-feature__fineprint">学習の反映は設定や入力状況により異なります。</p>
          </div>
          <div class="mz-feature__visual">
            <ProductDemo id="learning-demo" {...media.learning} />
          </div>
        </div>
      </section>

      <section class="mz-section" id="customization" aria-labelledby="custom-title">
        <div class="mz-shell mz-feature">
          <div class="mz-feature__copy">
            <span class="mz-kicker">03 / CUSTOMIZATION</span>
            <!-- MOZKEY PLAYBACK AND INSTALL GUIDE V2: controlled Japanese line wrapping -->
            <h2 id="custom-title" class="mz-custom-heading"><span>心地よさも、</span><span>使いやすさも、</span><span>自分好みに。</span></h2>
            <p>候補ウィンドウの見た目から、キー操作やローマ字入力のルールまで。使い慣れた入力環境を自分で作れます。</p>
          </div>
          <div class="mz-feature__visual">
            <ProductDemo id="customization-demo" {...media.customization} />
          </div>
        </div>
      </section>

      <section class="mz-privacy" id="privacy" aria-labelledby="privacy-title">
        <div class="mz-shell mz-privacy__inner">
          <div>
            <span class="mz-kicker mz-kicker--light">LOCAL-FIRST BY DESIGN</span>
            <h2 id="privacy-title">あなたの入力は、<br />あなたのもの。</h2>
          </div>
          <div class="mz-privacy__body">
            <p>Mozkeyはオフライン動作を重視し、ZenzによるAI補正も端末内で完結します。利用統計などのテレメトリ送信を無効化し、プライバシー保護とセキュリティ対策を多層的に実装。不要な外部通信を避けるため、自動更新機能も搭載していません。オープンソースで開発しています。</p>
            <p class="mz-privacy__terms">Local AI <span aria-hidden="true">/</span> Open Source <span aria-hidden="true">/</span> Privacy-conscious</p>
            <a class="mz-privacy__link" href={links.security} target="_blank" rel="noopener noreferrer">セキュリティの設計と制限事項 <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <DownloadArea />
      <section class="mz-sponsors" id="sponsors" aria-labelledby="mz-sponsors-title">
        <div class="mz-shell mz-sponsors__inner">
          <div class="mz-sponsors__copy">
            <span class="mz-kicker">SUPPORT OPEN SOURCE</span>
            <h2 id="mz-sponsors-title">開発を応援する。</h2>
            <p>Mozkeyの継続的な開発と改善を、GitHub Sponsorsから応援できます。いただいた支援は、開発を続けるための力になります。</p>
          </div>
          <a class="mz-sponsors__button" href="https://github.com/sponsors/koyasi777" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" /></svg>
            GitHub Sponsorsで応援する <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="mz-shell mz-sponsors__supporters" data-mz-public-sponsors hidden aria-label="公開中のGitHub Sponsors支援者">
          <p>開発を支えてくださっている皆さん</p>
          <div class="mz-sponsors__avatars" data-mz-public-sponsors-avatars></div>
        </div>
      </section>
      <section class="mz-discover" id="more-by-koyasi777" aria-labelledby="mz-discover-title">
        <div class="mz-shell">
          <div class="mz-discover__head">
            <span class="mz-kicker">MORE FROM KOYASI777</span>
            <h2 id="mz-discover-title">ほかにも、つくっています。</h2>
            <p>日本語入力からキーボード配列、検索ツールまで。ほかの制作物も紹介しています。</p>
          </div>
          <nav class="mz-discover__links" aria-label="koyasi777の他のページ">
            <a class="mz-discover__link" href="/seoto/">
              <span class="mz-discover__number" aria-hidden="true">01</span>
              <span class="mz-discover__text"><strong>せおと配列</strong><span>日本語を指の流れから考えたキーボード配列</span></span>
              <span class="mz-discover__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="mz-discover__link" href="/projects/">
              <span class="mz-discover__number" aria-hidden="true">02</span>
              <span class="mz-discover__text"><strong>制作物一覧</strong><span>公開しているソフトウェアやツールを見る</span></span>
              <span class="mz-discover__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="mz-discover__link" href="/">
              <span class="mz-discover__number" aria-hidden="true">03</span>
              <span class="mz-discover__text"><strong>koyasi777.com</strong><span>制作者のホームページへ戻る</span></span>
              <span class="mz-discover__arrow" aria-hidden="true">↗</span>
            </a>
          </nav>
        </div>
      </section>
    </main>

    <footer class="mz-footer">
      <div class="mz-shell mz-footer__top">
        <div class="mz-footer__brand">
          <a href="/mozkey/"><img src="/mozkey/icon.svg" width="32" height="32" alt="" loading="lazy" decoding="async" /> Mozkey</a>
          <p>Mozcをベースにした非公式フォークであり、Googleの公式製品ではありません。Googleによるサポートや品質保証の対象外です。</p>
        </div>
        <nav aria-label="製品ドキュメント">
          <a href="/">制作者ホーム</a>
          <a href="/projects/">制作物一覧</a>
          <a href={links.repository} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={links.readme} target="_blank" rel="noopener noreferrer">README ↗</a>
          <a href={links.releases} target="_blank" rel="noopener noreferrer">Releases ↗</a>
          <a href={links.notices} target="_blank" rel="noopener noreferrer">ライセンス・クレジット ↗</a>
        </nav>
      </div>
      <div class="mz-shell mz-footer__bottom">
        <p>© 2026 koyasi777. Based on <a href={links.mozc} target="_blank" rel="noopener noreferrer">Mozc</a>. See <a href={links.notices} target="_blank" rel="noopener noreferrer">third-party notices</a> for Zenz, llama.cpp and other components.</p>
        <a href={links.creator}>koyasi777.com <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
    <script>
      // Show only public GitHub Sponsors from our hourly KV snapshot.
      async function loadMozkeyPublicSponsors(): Promise<void> {
        const section = document.querySelector<HTMLElement>("[data-mz-public-sponsors]");
        const avatars = document.querySelector<HTMLElement>("[data-mz-public-sponsors-avatars]");
        if (!section || !avatars) return;
        try {
          const response = await fetch("/api/mozkey/sponsors", {
            headers: { Accept: "application/json" },
          });
          if (!response.ok) return;
          const json: unknown = await response.json();
          if (!json || typeof json !== "object" || !('sponsors' in json) ||
              !Array.isArray(json.sponsors)) return;

          const fragment = document.createDocumentFragment();
          for (const login of json.sponsors.slice(0, 48)) {
            if (typeof login !== "string" || !/^[a-z0-9](?:[a-z0-9-]{0,38})$/i.test(login) ||
                login.endsWith("-")) continue;
            const link = document.createElement("a");
            link.href = `https://github.com/${login}`;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.title = `@${login}`;
            link.setAttribute("aria-label", `スポンサー @${login} のGitHubプロフィール`);
            const avatar = document.createElement("img");
            avatar.src = `https://github.com/${login}.png?size=96`;
            avatar.width = 46;
            avatar.height = 46;
            avatar.loading = "lazy";
            avatar.decoding = "async";
            avatar.referrerPolicy = "no-referrer";
            avatar.alt = `@${login}`;
            link.appendChild(avatar);
            fragment.appendChild(link);
          }
          if (!fragment.childNodes.length) return;
          avatars.replaceChildren(fragment);
          section.hidden = false;
        } catch {
          // Sponsorship data is optional; never interfere with the page or downloads.
        }
      }
      void loadMozkeyPublicSponsors();
    </script>
    <script>
      // Public metrics are proxied through our Worker; browsers never query GitHub API directly.
      async function loadMozkeyPublicStats(): Promise<void> {
        const wrapper = document.querySelector<HTMLElement>("[data-mz-stats]");
        const githubFallback = document.querySelector<HTMLElement>("[data-mz-stats-fallback]");
        const starsItem = document.querySelector<HTMLElement>("[data-mz-stars-stat]");
        const downloadsItem = document.querySelector<HTMLElement>("[data-mz-downloads-stat]");
        if (!wrapper || !githubFallback || !starsItem || !downloadsItem) return;
        let starsLoaded = false;
        let downloadsLoaded = false;
        try {
          const response = await fetch("/api/mozkey/stats", {
            cache: "no-store", headers: { Accept: "application/json" },
          });
          if (!response.ok) throw new Error("GitHub statistics unavailable");
          const json: unknown = await response.json();
          if (!json || typeof json !== "object" || Array.isArray(json)) {
            throw new Error("Unexpected statistics response");
          }
          const stats = json as Record<string, unknown>;
          const validCount = (count: unknown): count is number =>
            typeof count === "number" && Number.isSafeInteger(count) && count >= 0;
          const formatCount = (count: number): string => new Intl.NumberFormat("ja-JP").format(count);
          if (validCount(stats.stars)) {
            const value = starsItem.querySelector<HTMLElement>("[data-mz-stars-count]");
            if (value) {
              value.textContent = formatCount(stats.stars);
              starsItem.hidden = false;
              starsLoaded = true;
            }
          }
          if (validCount(stats.installerDownloads)) {
            const value = downloadsItem.querySelector<HTMLElement>("[data-mz-downloads-count]");
            if (value) {
              value.textContent = formatCount(stats.installerDownloads);
              downloadsItem.hidden = false;
              downloadsLoaded = true;
            }
          }
        } catch {
          // Statistics are optional and must never interfere with downloads.
        } finally {
          // Show the GitHub link only if at least one statistic is unavailable.
          githubFallback.hidden = starsLoaded && downloadsLoaded;
          wrapper.hidden = false;
        }
      }
      void loadMozkeyPublicStats();
    </script>
    <script>
      // Preserve the desktop two-column markup. On mobile, the demo precedes the lead text.
      const heroGrid = document.querySelector<HTMLElement>(".mz-hero__grid");
      const heroCopy = heroGrid?.querySelector<HTMLElement>(".mz-hero__copy");
      const heroLead = heroCopy?.querySelector<HTMLElement>(".mz-hero__lead");
      const heroMedia = heroGrid?.querySelector<HTMLElement>(".mz-hero__media");
      const mobileHero = window.matchMedia("(max-width: 767px)");

      if (heroGrid && heroCopy && heroLead && heroMedia) {
        const positionHeroMedia = () => {
          if (mobileHero.matches) {
            if (heroMedia.nextElementSibling !== heroLead) {
              heroLead.insertAdjacentElement("beforebegin", heroMedia);
            }
          } else if (heroMedia.parentElement !== heroGrid) {
            heroGrid.appendChild(heroMedia);
          }
        };
        positionHeroMedia();
        mobileHero.addEventListener("change", positionHeroMedia);
      }
    </script>
  </body>
</html>
