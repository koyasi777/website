{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koyasi777-com",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "koyasi777.com",
      "custom_domain": true
    }
  ]
}