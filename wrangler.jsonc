{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koyasi777-com",
  "compatibility_date": "2026-09-05",
  "main": "src/worker.mjs",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": ["/api/mozkey/*"]
  },
  "kv_namespaces": [{ "binding": "MOZKEY_CACHE", "id": "70b32084948f45ba993a83c3cd500686" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    {
      "pattern": "koyasi777.com",
      "custom_domain": true
    }
  ]
}